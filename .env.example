# Environment Variables Template
# Copy this file to .env.local in the project root directory and add your credentials.

# 1. OpenRouter API Key for MyRA AI Chatbot (Optional - Fallback Engine Active)
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# 2. Supabase Credentials for Live Group Sync (Optional - LocalStorage Active)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
